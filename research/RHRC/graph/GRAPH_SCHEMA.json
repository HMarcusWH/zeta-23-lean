{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhkg-phase2b-graph-schema-0.4",
  "title": "RHKG Phase-2B compiler dependency graph record schema",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/repository"
    },
    {
      "$ref": "#/$defs/repoFile"
    },
    {
      "$ref": "#/$defs/leanModule"
    },
    {
      "$ref": "#/$defs/registeredClaim"
    },
    {
      "$ref": "#/$defs/route"
    },
    {
      "$ref": "#/$defs/controlObject"
    },
    {
      "$ref": "#/$defs/historicalDelta"
    },
    {
      "$ref": "#/$defs/researchExecutable"
    },
    {
      "$ref": "#/$defs/fixture"
    },
    {
      "$ref": "#/$defs/workflowDefinition"
    },
    {
      "$ref": "#/$defs/leanDeclaration"
    },
    {
      "$ref": "#/$defs/relation"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "repository": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "Repository"
            },
            "repository": {
              "type": "string"
            }
          },
          "required": [
            "repository"
          ]
        }
      ]
    },
    "repoFile": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "RepoFile"
            },
            "path": {
              "type": "string"
            },
            "file_class": {
              "type": "string"
            },
            "trust_zone": {
              "type": "string"
            },
            "generated_product": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "file_class",
            "trust_zone",
            "generated_product"
          ]
        }
      ]
    },
    "leanModule": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "LeanModule"
            },
            "module": {
              "type": "string"
            },
            "repository_scope": {
              "enum": [
                "LOCAL",
                "EXTERNAL"
              ]
            }
          },
          "required": [
            "module",
            "repository_scope"
          ]
        }
      ]
    },
    "registeredClaim": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "RegisteredClaim"
            },
            "claim_id": {
              "type": "string"
            },
            "authority_role": {
              "const": "NORMALIZED_MIRROR"
            },
            "projection": {
              "type": "object"
            }
          },
          "required": [
            "claim_id",
            "authority_role",
            "projection"
          ]
        }
      ]
    },
    "route": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "Route"
            },
            "route_id": {
              "type": "string"
            },
            "authority_role": {
              "const": "NORMALIZED_MIRROR"
            },
            "projection": {
              "type": "object"
            }
          },
          "required": [
            "route_id",
            "authority_role",
            "projection"
          ]
        }
      ]
    },
    "relation": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "Relation"
            },
            "kind": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "provenance": {
              "type": "string"
            },
            "used_in_type": {
              "type": "boolean"
            },
            "used_in_value": {
              "type": "boolean"
            },
            "used_in_structure": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "source",
            "target",
            "provenance"
          ]
        }
      ]
    },
    "controlObject": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "ControlObject"
            },
            "path": {
              "type": "string"
            },
            "file_id": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "file_id"
          ]
        }
      ]
    },
    "historicalDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "HistoricalDelta"
            },
            "path": {
              "type": "string"
            },
            "file_id": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "file_id"
          ]
        }
      ]
    },
    "researchExecutable": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "ResearchExecutable"
            },
            "path": {
              "type": "string"
            },
            "file_id": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "file_id"
          ]
        }
      ]
    },
    "fixture": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "Fixture"
            },
            "path": {
              "type": "string"
            },
            "file_id": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "file_id"
          ]
        }
      ]
    },
    "workflowDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "WorkflowDefinition"
            },
            "path": {
              "type": "string"
            },
            "file_id": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "file_id"
          ]
        }
      ]
    },
    "leanDeclaration": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "LeanDeclaration"
            },
            "declaration": {
              "type": "string",
              "minLength": 1
            },
            "module": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "module_id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_path": {
              "type": "string",
              "minLength": 1
            },
            "source_file_id": {
              "type": "string",
              "minLength": 1
            },
            "binding_scope": {
              "enum": [
                "REGISTERED_PROVED"
              ]
            },
            "authority_role": {
              "enum": [
                "REGISTERED_CLAIM_DECLARATION",
                "DEPENDENCY_DECLARATION",
                "EXTERNAL_BOUNDARY_DECLARATION"
              ]
            },
            "binding_source": {
              "type": "string",
              "minLength": 1
            },
            "compiler_binding_source": {
              "type": "string",
              "minLength": 1
            },
            "source_locator": {
              "type": "object"
            },
            "historical_r003_promoted": {
              "type": "boolean"
            },
            "repository_scope": {
              "enum": [
                "LOCAL",
                "EXTERNAL"
              ]
            },
            "graph_role": {
              "enum": [
                "REGISTERED_CLAIM_ROOT",
                "LOCAL_DEPENDENCY",
                "EXTERNAL_BOUNDARY"
              ]
            },
            "declaration_kind": {
              "type": "string",
              "minLength": 1
            },
            "private_or_internal": {
              "type": "boolean"
            }
          },
          "required": [
            "declaration",
            "module",
            "repository_scope",
            "graph_role",
            "declaration_kind",
            "private_or_internal",
            "authority_role"
          ]
        }
      ]
    }
  }
}
