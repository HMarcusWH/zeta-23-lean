    4 * (1 + L) * Real.exp (L / 2) * Zeta23.CCM.nativePhysicalH1Norm f * Zeta23.CCM.nativePhysicalH1Norm v
Zeta23.CCM.nativeWeilResponse_bilinear_bound :
  ∃ C_Q,
    0 < C_Q ∧
      ∀ (L : ℝ) (f v : ℝ → ℂ),
        0 ≤ L →
          ContDiff ℝ 2 f →
            ContDiff ℝ 2 v →
              tsupport f ⊆ Set.Icc 0 L →
                tsupport v ⊆ Set.Icc 0 L →
                  ‖Zeta23.zetaZeroConfig.W f v‖ ≤
