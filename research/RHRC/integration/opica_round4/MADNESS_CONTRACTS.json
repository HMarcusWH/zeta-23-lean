{
  "schema": "OPICA4_MADNESS_CONTRACTS_V1",
  "RH": "OPEN",
  "Step4": "OPEN",
  "scope_version": "MADNESS_2026_11_01_EXACT_SOURCE_REDUCTION_V1",
  "objective": "Attempt the independent source arithmetic estimate needed for Step4 using the complete supplied corpus and merged OPICA constraints.",
  "contracts": [
    {
      "id": "M1",
      "module": "Zeta23.OPICARound4.MobiusHyperbola",
      "claim": "Exact finite genuine-mu Dirichlet hyperbola and actual von Mangoldt convolution; log1=0 sharpens outer support N to floor(N/2).",
      "arithmetic_estimate_supplied": false
    },
    {
      "id": "M2",
      "module": "Zeta23.OPICARound4.ActualSourceHyperbola",
      "claim": "Literal fixed kappa*kappa prime field, all prime powers, actual history cutoff, native-source convolution and integer-drive identities. Exact normalization and late-drive transfer remain distinct from a stable global inverse. The entire normalized short term has every fixed exponential decay rate using only abs(mu)<=1, with a uniform source-only threshold. Consequently actualCorrelationPrimeField plus the complete normalized long term has every fixed exponential decay rate; neither summand is independently bounded.",
      "arithmetic_estimate_supplied": false
    },
    {
      "id": "M3",
      "module": "Zeta23.OPICARound4.HyperbolaDiagonal",
      "claim": "Genuine-mu diagonal is bounded by M*sqrt(T)*sqrt(x) under a bounded-remainder premise; exact lower-bound equivalence retains the rank-one contribution (nonnegative for I>=0 and x>=0) and all off-diagonal terms.",
      "literal_Poisson_adapter": "PAPER_DERIVED_NOT_FORMALIZED_HERE",
      "arithmetic_estimate_supplied": false
    },
    {
      "id": "M4",
      "module": "Zeta23.OPICARound4.Validation.Hyperbola",
      "claim": "Independent complete expected-type consumers. Negative controls reject changed sign, missing normalization, omitted diagonal and promotion of an equivalence to an estimate.",
      "arithmetic_estimate_supplied": false
    }
  ],
  "closing_arithmetic": {
    "status": "OPEN",
    "formula": "I_F*x*(sum_(a<=floor sqrt(T*x)) mu(a)/a)^2 + sum_(a!=b<=floor sqrt(T*x)) mu(a)*mu(b)*R_F(x/(a*b)) >= -C*sqrt(x)",
    "quantifiers": "There exist C,X0>0 before choosing real x>=X0; fixed genuine source, actual mu, all signed pairs, helpful rank-one retained.",
    "not_equivalent_without_adapters": "The generic diagonal module does not itself construct the analytic P_F/R_F or prove their paper regularity. The actual source finite logarithmic test is normalized by 1/sqrt(x), x=exp(t); normalized hyperbolaT needs a constant-scale lower bound, not the same sqrt(x) bound.",
    "pass8": "At x=N^2/T the paper-level target is H_N >= -C*N. The moment/spectral representation and negative-spectrum controls do not provide it."
  },
  "validation": "Exact current-head full types, transitive axioms, source bindings, retained scope, semantic controls and independent production acceptance required.",
  "authority": "SOURCE_BOUND_RESEARCH_REGISTER_NOT_PROOF_RECEIPT",
  "claim_cap": "SUPPORT_ONLY_RH_AND_STEP4_OPEN",
