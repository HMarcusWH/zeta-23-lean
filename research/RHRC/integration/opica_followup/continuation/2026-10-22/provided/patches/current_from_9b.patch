+lemma auxProfile_integrable (k : ℕ) (hk : 1≤k) :
+    Integrable (fun u : ℝ => (auxCompletionProfile k u : ℂ)) :=
+  (auxProfile_continuous k hk).integrable_of_hasCompactSupport (auxProfile_compactSupport k)
