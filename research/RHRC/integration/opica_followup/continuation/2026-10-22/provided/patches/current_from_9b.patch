+    apply (div_le_iff₀ (sq_pos_of_pos Real.pi_pos)).mpr
+    nlinarith [sincSquared_nonneg (Real.exp u)]
+  convert hfinal using 1
+  unfold firstCellLowerLog
+  rw [div_pow,mul_pow,sq_abs]
+  field_simp
+  ring
