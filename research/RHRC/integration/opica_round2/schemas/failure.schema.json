{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "OPICA2_FAILURE_V1"
    },
    "outcome": {
      "enum": [
        "FAILED",
        "UNRESOLVED",
        "INVALID_CERTIFICATE"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "observed_at_utc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source_identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "commit",
            "tree"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifact_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "has_proof_authority": {
      "const": false
    },
    "full_core_accepted": {
      "const": false
    },
    "full_release_accepted": {
      "const": false
    },
    "RH": {
      "const": "OPEN"
    },
    "Step4": {
      "const": "OPEN"
    }
  },
  "required": [
    "schema",
    "outcome",
    "stage",
    "code",
    "message",
    "observed_at_utc",
    "source_identity",
    "artifact_hashes",
    "has_proof_authority",
    "full_core_accepted",
    "full_release_accepted",
    "RH",
    "Step4"
  ],
  "additionalProperties": false,
  "description": "Early failure or resource limit without fabricated compiler objects or theorem authority."
}
