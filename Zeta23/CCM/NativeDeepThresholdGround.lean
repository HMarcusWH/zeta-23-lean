import Zeta23.CCM.NativePoleNeutralTrialDepth

noncomputable section

namespace Zeta23.CCM

open scoped ComplexConjugate

set_option allowUnsafeReducibility true in
attribute [local reducible] Submodule.innerProductSpace
  poleNeutralEven_innerProductSpace poleNeutralOdd_innerProductSpace
  euclideanParityBoundaryFlatSubspace

/-!
The actual least native bottom crossing generated by the supplied detector.

The detector remains at Kd. The selected ground is constructed independently
from the actual native ground theorem at the least crossing cutoff K. Its
actual eigenvalue `lam` is stored separately from the detector threshold
`-eta`. The first cutoff K=3 has empty native predecessor spaces at K=2;
no numerical bottom is assigned to those spaces.
-/

private theorem unit_eigenmode_of_nonzero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (A : E →ₗ[ℂ] E) (lam : ℝ) (u : E) (hu0 : u ≠ 0)
    (hu : A u = (lam : ℂ) • u) : ∃ v : E, ‖v‖ = 1 ∧ A v = (lam : ℂ) • v := by
  let v := ((‖u‖ : ℂ)⁻¹) • u
  have hnorm : ‖v‖ = 1 := by
    dsimp only [v]
    rw [norm_smul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (norm_nonneg u), inv_mul_cancel₀ (norm_ne_zero_iff.mpr hu0)]
  refine ⟨v, hnorm, ?_⟩
  simp only [v, map_smul, hu, smul_smul]
  congr 1
  ring

structure NativeDeepThresholdGroundData (L : ℝ) (Kd : ℕ) (D : ℝ) (hL : 0 < L) where
  eta : ℝ
  cutoff : ℕ
  cutoff_nonempty : 3 ≤ cutoff
  cutoff_le_detector : cutoff ≤ Kd
  lam : ℝ
  lam_is_actual_global : lam = poleNeutralGlobalRayleighBottom L cutoff hL cutoff_nonempty
  eta_lower : D / 3 < eta
  eta_upper : eta < D / 2
  lam_depth : lam ≤ -eta - nativeDeepThresholdGap D Kd
  unit_actual_ground :
    (∃ u : poleNeutralEvenSubspace L cutoff, ‖u‖ = 1 ∧
      poleNeutralEvenCompressedCanonical L cutoff u = (lam : ℂ) • u) ∨
    (∃ w : poleNeutralOddSubspace L cutoff, ‖w‖ = 1 ∧
      poleNeutralOddCompressedCanonical L cutoff w = (lam : ℂ) • w)
  earlier_bottoms : ∀ J : ℕ, (hJ : 3 ≤ J) → J < cutoff →
    -eta + nativeDeepThresholdGap D Kd ≤ poleNeutralGlobalRayleighBottom L J hL hJ
  predecessor_bottoms : ∀ hprev : 3 ≤ cutoff - 1,
    (-eta + nativeDeepThresholdGap D Kd ≤ poleNeutralEvenRayleighBottom L (cutoff - 1) hL hprev) ∧
    (-eta + nativeDeepThresholdGap D Kd ≤ poleNeutralOddRayleighBottom L (cutoff - 1) hL hprev)
  first_predecessor_empty : cutoff = 3 →
    Module.finrank ℂ (poleNeutralEvenSubspace L 2) = 0 ∧
      Module.finrank ℂ (poleNeutralOddSubspace L 2) = 0

/-- Construct the actual selected ground from the given original finite
trial and the actual bottom-only avoidance theorem. -/
theorem exists_nativeDeepThresholdGround_of_given_trial {L : ℝ} (hL : 0 < L)
    (Kd : ℕ) (hKd : 3 ≤ Kd) (D : ℝ) (hD : 0 < D)
    (p : EuclideanSpace ℂ (Fin (2 * Kd + 1)))
    (hlegal : p ∈ euclideanBoundaryFlatSubspace Kd)
    (hpEven : canonicalPoleEvenFunctional L Kd p = 0)
    (hpOdd : canonicalPoleOddFunctional L Kd p = 0) (hpUnit : ‖p‖ = 1)
    (hpDepth : (inner ℂ ((canonicalSourceMatrix L Kd).toEuclideanLin p) p).re ≤ -D) :
    Nonempty (NativeDeepThresholdGroundData L Kd D hL) := by
  classical
  have hdeep := nativeGlobalBottom_le_neg_depth_of_given_unit_trial
    hL Kd hKd D p hlegal hpEven hpOdd hpUnit hpDepth
  obtain ⟨eta, hlo, hhi, hsep⟩ := exists_nativeDeepThreshold_bottom_separator hL Kd hKd D hD
  let Cross : ℕ → Prop := fun K => ∃ hK : 3 ≤ K,
    K ≤ Kd ∧ poleNeutralGlobalRayleighBottom L K hL hK < -eta
  have hex : ∃ K, Cross K := by
    refine ⟨Kd, hKd, le_rfl, ?_⟩
    linarith
  let K := Nat.find hex
  have hspec := Nat.find_spec hex
  change Cross K at hspec
  obtain ⟨hK, hKKd, hcross⟩ := hspec
  let lam := poleNeutralGlobalRayleighBottom L K hL hK
  have hdepth : lam ≤ -eta - nativeDeepThresholdGap D Kd :=
    nativeDeepThreshold_crossing_retains_gap hL K Kd hK D eta hcross (hsep K hK hKKd)
  have hearlier (J : ℕ) (hJ : 3 ≤ J) (hJK : J < K) :
      -eta + nativeDeepThresholdGap D Kd ≤ poleNeutralGlobalRayleighBottom L J hL hJ := by
    have hJKd : J ≤ Kd := by omega
    have hnocross : -eta ≤ poleNeutralGlobalRayleighBottom L J hL hJ := by
      by_contra hn
      push Not at hn
      exact Nat.find_min hex hJK ⟨hJ, hJKd, hn⟩
    exact nativeDeepThreshold_noncrossing_has_lower_gap hL J Kd hJ D eta hnocross (hsep J hJ hJKd)
  have hground :
      (∃ u : poleNeutralEvenSubspace L K, ‖u‖ = 1 ∧
        poleNeutralEvenCompressedCanonical L K u = (lam : ℂ) • u) ∨
      (∃ w : poleNeutralOddSubspace L K, ‖w‖ = 1 ∧
        poleNeutralOddCompressedCanonical L K w = (lam : ℂ) • w) := by
    by_cases heo : poleNeutralEvenRayleighBottom L K hL hK ≤ poleNeutralOddRayleighBottom L K hL hK
    · left
      have hlam : lam = poleNeutralEvenRayleighBottom L K hL hK := min_eq_left heo
      obtain ⟨u, hu0, hu⟩ := exists_eigenmode_at_poleNeutralEvenRayleighBottom hL K hK
      rw [← hlam] at hu
      exact @unit_eigenmode_of_nonzero (poleNeutralEvenSubspace L K) inferInstance
        (poleNeutralEven_innerProductSpace L K) (poleNeutralEvenCompressedCanonical L K) lam u hu0 hu
    · right
      have hoe : poleNeutralOddRayleighBottom L K hL hK ≤ poleNeutralEvenRayleighBottom L K hL hK := le_of_not_ge heo
      have hlam : lam = poleNeutralOddRayleighBottom L K hL hK := min_eq_right hoe
      obtain ⟨w, hw0, hw⟩ := exists_eigenmode_at_poleNeutralOddRayleighBottom hL K hK
      rw [← hlam] at hw
      exact @unit_eigenmode_of_nonzero (poleNeutralOddSubspace L K) inferInstance
        (poleNeutralOdd_innerProductSpace L K) (poleNeutralOddCompressedCanonical L K) lam w hw0 hw
  refine ⟨{
    eta := eta
    cutoff := K
    cutoff_nonempty := hK
    cutoff_le_detector := hKKd
    lam := lam
    lam_is_actual_global := rfl
    eta_lower := hlo
    eta_upper := hhi
    lam_depth := hdepth
    unit_actual_ground := hground
    earlier_bottoms := hearlier
    predecessor_bottoms := ?_
    first_predecessor_empty := ?_ }⟩
  · intro hprev
    have hprevK : K - 1 < K := by omega
    have hb := hearlier (K - 1) hprev hprevK
    refine ⟨hb.trans ?_, hb.trans ?_⟩
    · exact min_le_left _ _
    · exact min_le_right _ _
  · intro _
    constructor
    · simpa only [finrank_poleNeutralEvenSubspace hL 2 (by omega)]
    · simpa only [finrank_poleNeutralOddSubspace hL 2 (by omega)]

end Zeta23.CCM

#print axioms Zeta23.CCM.exists_nativeDeepThresholdGround_of_given_trial
