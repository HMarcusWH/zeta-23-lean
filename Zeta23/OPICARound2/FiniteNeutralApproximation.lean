import Zeta23.CCM.BoundaryFlatApproximation
import Zeta23.CCM.CanonicalPoleNeutralCarrier
import Zeta23.CCM.CanonicalPoleExponentialMoments
import Zeta23.CCM.CanonicalPoleNeutralNesting
import Zeta23.ExceptionalZero.FiniteNegativeObstruction
import Zeta23.ExceptionalZero.RHTerminalConfigAttempt

/-! Exact legal centered pole correctors, fixed-aperture physical X continuity,
and the eventual finite neutral negative obstruction generated by an off-line
zero. The construction supplies neither a no-exit sign nor an RH proof. -/

noncomputable section

open Complex Matrix MeasureTheory Set Filter
open scoped BigOperators Topology

namespace Zeta23.OPICARound2

def neutralEvenFunctional (a : ℝ) (K : ℕ) (u : Fin (2 * K + 1) → ℂ) : ℂ :=
  ∑ i, u i / ((a : ℂ) + (CCM.centeredIndex K i : ℂ) ^ 2)

def neutralOddFunctional (a : ℝ) (K : ℕ) (u : Fin (2 * K + 1) → ℂ) : ℂ :=
  ∑ i, (CCM.centeredIndex K i : ℂ) * u i /
    ((a : ℂ) + (CCM.centeredIndex K i : ℂ) ^ 2)

private theorem parameter_nonzero {a : ℝ} (ha : 0 < a) :
    (a : ℂ) ≠ 0 ∧ ((a : ℂ) + 1) ≠ 0 ∧ ((a : ℂ) + 4) ≠ 0 := by
  constructor
  · exact Complex.ofReal_ne_zero.mpr ha.ne'
  constructor <;> norm_cast <;> linarith

theorem neutral_even_corrector_pairings {a : ℝ} (ha : 0 < a) :
    neutralEvenFunctional a 2 CCM.positiveEvenSourceWitness =
      24 / ((a : ℂ) * ((a : ℂ) + 1) * ((a : ℂ) + 4)) ∧
    neutralOddFunctional a 2 CCM.positiveEvenSourceWitness = 0 := by
  obtain ⟨ha0,ha1,ha4⟩ := parameter_nonzero ha
  have h1a : (1 : ℂ) + (a : ℂ) ≠ 0 := by simpa [add_comm] using ha1
  have h4a : (4 : ℂ) + (a : ℂ) ≠ 0 := by simpa [add_comm] using ha4
  constructor
  all_goals
    norm_num [neutralEvenFunctional, neutralOddFunctional, CCM.positiveEvenSourceWitness,
      Fin.sum_univ_succ, CCM.centeredIndex]
    field_simp [ha0,ha1,ha4,h1a,h4a]
    ring

theorem neutral_odd_corrector_pairings {a : ℝ} (ha : 0 < a) :
    neutralEvenFunctional a 2 CCM.oddSourceWitnessK2 = 0 ∧
    neutralOddFunctional a 2 CCM.oddSourceWitnessK2 =
      -12 / (((a : ℂ) + 1) * ((a : ℂ) + 4)) := by
  obtain ⟨ha0,ha1,ha4⟩ := parameter_nonzero ha
  have h1a : (1 : ℂ) + (a : ℂ) ≠ 0 := by simpa [add_comm] using ha1
  have h4a : (4 : ℂ) + (a : ℂ) ≠ 0 := by simpa [add_comm] using ha4
  constructor
  all_goals
    norm_num [neutralEvenFunctional, neutralOddFunctional, CCM.oddSourceWitnessK2,
      Fin.sum_univ_succ, CCM.centeredIndex]
    field_simp [ha0,ha1,ha4,h1a,h4a]
    ring

/-- The native centered-index image is twice the odd stencil, so its denominator
cannot be silently substituted for the odd stencil's denominator. -/
theorem neutral_native_odd_scaling :
    (fun i : Fin (2 * 2 + 1) => (CCM.centeredIndex 2 i : ℂ) *
      CCM.positiveEvenSourceWitness i) = 2 • CCM.oddSourceWitnessK2 := by
  funext i
  fin_cases i <;> norm_num [CCM.centeredIndex, CCM.positiveEvenSourceWitness,
    CCM.oddSourceWitnessK2, Pi.smul_apply, smul_eq_mul]

theorem neutral_correctors_legal :
    CCM.BoundaryFlatCoefficients 2 CCM.positiveEvenSourceWitness ∧
      CCM.BoundaryFlatCoefficients 2 CCM.oddSourceWitnessK2 :=
  ⟨(CCM.mem_boundaryFlatSubspace_iff 2 _).mp CCM.positiveEvenSourceWitness_mem.1,
    (CCM.mem_boundaryFlatSubspace_iff 2 _).mp CCM.oddSourceWitnessK2_mem.1⟩

theorem neutralEvenFunctional_centeredZeroExtend (a : ℝ)
    {N K : ℕ} (hNK : N ≤ K) (u : Fin (2 * N + 1) → ℂ) :
    neutralEvenFunctional a K (CCM.centeredZeroExtend hNK u) =
      neutralEvenFunctional a N u := by
  unfold neutralEvenFunctional
  rw [Fintype.sum_of_injective (CCM.centeredEmbedding N K hNK)
    (CCM.centeredEmbedding N K hNK).injective
    (fun i : Fin (2 * N + 1) => u i / ((a : ℂ) + (CCM.centeredIndex N i : ℂ) ^ 2))
    (fun j : Fin (2 * K + 1) => CCM.centeredZeroExtend hNK u j /
      ((a : ℂ) + (CCM.centeredIndex K j : ℂ) ^ 2))]
  · intro j hj
    rw [CCM.centeredZeroExtend_apply_of_not_mem_range hNK u j]
    · simp
    · simpa using hj
  · intro i
    simp

theorem neutralOddFunctional_centeredZeroExtend (a : ℝ)
    {N K : ℕ} (hNK : N ≤ K) (u : Fin (2 * N + 1) → ℂ) :
    neutralOddFunctional a K (CCM.centeredZeroExtend hNK u) =
      neutralOddFunctional a N u := by
  unfold neutralOddFunctional
  rw [Fintype.sum_of_injective (CCM.centeredEmbedding N K hNK)
    (CCM.centeredEmbedding N K hNK).injective
    (fun i : Fin (2 * N + 1) => (CCM.centeredIndex N i : ℂ) * u i /
      ((a : ℂ) + (CCM.centeredIndex N i : ℂ) ^ 2))
    (fun j : Fin (2 * K + 1) => (CCM.centeredIndex K j : ℂ) * CCM.centeredZeroExtend hNK u j /
      ((a : ℂ) + (CCM.centeredIndex K j : ℂ) ^ 2))]
  · intro j hj
    rw [CCM.centeredZeroExtend_apply_of_not_mem_range hNK u j]
    · simp
    · simpa using hj
  · intro i
    simp

def neutralEvenCorrector (K : ℕ) (hK : 2 ≤ K) : Fin (2 * K + 1) → ℂ :=
  CCM.centeredZeroExtend hK CCM.positiveEvenSourceWitness

def neutralOddCorrector (K : ℕ) (hK : 2 ≤ K) : Fin (2 * K + 1) → ℂ :=
  CCM.centeredZeroExtend hK CCM.oddSourceWitnessK2

def neutralRepair (a : ℝ) (K : ℕ) (hK : 2 ≤ K) (u : Fin (2 * K + 1) → ℂ) :
    Fin (2 * K + 1) → ℂ :=
  u - (neutralEvenFunctional a K u /
      neutralEvenFunctional a K (neutralEvenCorrector K hK)) • neutralEvenCorrector K hK -
    (neutralOddFunctional a K u /
      neutralOddFunctional a K (neutralOddCorrector K hK)) • neutralOddCorrector K hK

theorem neutralRepair_legal (a : ℝ) (K : ℕ) (hK : 2 ≤ K)
    (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u) :
    CCM.BoundaryFlatCoefficients K (neutralRepair a K hK u) := by
  apply (CCM.mem_boundaryFlatSubspace_iff K _).mp
  have he : neutralEvenCorrector K hK ∈ CCM.boundaryFlatSubspace K :=
    CCM.centeredZeroExtend_mem_boundaryFlatSubspace hK CCM.positiveEvenSourceWitness_mem.1
  have ho : neutralOddCorrector K hK ∈ CCM.boundaryFlatSubspace K :=
    CCM.centeredZeroExtend_mem_boundaryFlatSubspace hK CCM.oddSourceWitnessK2_mem.1
  exact (CCM.boundaryFlatSubspace K).sub_mem
    ((CCM.boundaryFlatSubspace K).sub_mem ((CCM.mem_boundaryFlatSubspace_iff K _).mpr hu)
      ((CCM.boundaryFlatSubspace K).smul_mem _ he))
    ((CCM.boundaryFlatSubspace K).smul_mem _ ho)

private theorem evenFunctional_sub_smul (a : ℝ) (K : ℕ)
    (u v : Fin (2 * K + 1) → ℂ) (c : ℂ) :
    neutralEvenFunctional a K (u - c • v) =
      neutralEvenFunctional a K u - c * neutralEvenFunctional a K v := by
  simp [neutralEvenFunctional, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
    sub_div, mul_div_assoc, Finset.sum_sub_distrib, Finset.mul_sum]

private theorem oddFunctional_sub_smul (a : ℝ) (K : ℕ)
    (u v : Fin (2 * K + 1) → ℂ) (c : ℂ) :
    neutralOddFunctional a K (u - c • v) =
      neutralOddFunctional a K u - c * neutralOddFunctional a K v := by
  simp [neutralOddFunctional, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
    mul_sub, sub_div, mul_div_assoc, Finset.sum_sub_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  ring

theorem neutralRepair_exact {a : ℝ} (ha : 0 < a) (K : ℕ) (hK : 2 ≤ K)
    (u : Fin (2 * K + 1) → ℂ) :
    neutralEvenFunctional a K (neutralRepair a K hK u) = 0 ∧
      neutralOddFunctional a K (neutralRepair a K hK u) = 0 := by
  have he := neutral_even_corrector_pairings ha
  have ho := neutral_odd_corrector_pairings ha
  have heE : neutralEvenFunctional a K (neutralEvenCorrector K hK) =
      24 / ((a : ℂ) * ((a : ℂ) + 1) * ((a : ℂ) + 4)) := by
    simpa [neutralEvenCorrector, neutralEvenFunctional_centeredZeroExtend] using he.1
  have heO : neutralOddFunctional a K (neutralEvenCorrector K hK) = 0 := by
    simpa [neutralEvenCorrector, neutralOddFunctional_centeredZeroExtend] using he.2
  have hoE : neutralEvenFunctional a K (neutralOddCorrector K hK) = 0 := by
    simpa [neutralOddCorrector, neutralEvenFunctional_centeredZeroExtend] using ho.1
  have hoO : neutralOddFunctional a K (neutralOddCorrector K hK) =
      -12 / (((a : ℂ) + 1) * ((a : ℂ) + 4)) := by
    simpa [neutralOddCorrector, neutralOddFunctional_centeredZeroExtend] using ho.2
  obtain ⟨ha0,ha1,ha4⟩ := parameter_nonzero ha
  have hne : neutralEvenFunctional a K (neutralEvenCorrector K hK) ≠ 0 := by
    rw [heE]
    exact div_ne_zero (by norm_num) (mul_ne_zero (mul_ne_zero ha0 ha1) ha4)
  have hno : neutralOddFunctional a K (neutralOddCorrector K hK) ≠ 0 := by
    rw [hoO]
    exact div_ne_zero (by norm_num) (mul_ne_zero ha1 ha4)
  constructor
  · simp [neutralRepair, evenFunctional_sub_smul, hoE, div_mul_cancel₀ _ hne]
  · simp [neutralRepair, oddFunctional_sub_smul, heO, div_mul_cancel₀ _ hno]

def neutralPoleParameter (L : ℝ) : ℝ := (L / (4 * Real.pi)) ^ 2

theorem neutralPoleParameter_pos {L : ℝ} (hL : 0 < L) : 0 < neutralPoleParameter L := by
  unfold neutralPoleParameter
  positivity

private theorem native_profile_denominator (L : ℝ) (n : ℤ) :
    CCM.poleProfileDenominator n L =
      (16 * Real.pi ^ 2) * (neutralPoleParameter L + (n : ℝ) ^ 2) := by
  unfold CCM.poleProfileDenominator neutralPoleParameter
  field_simp [Real.pi_ne_zero]
  ring

theorem neutral_native_profile_scaling (L : ℝ) (K : ℕ) (u : Fin (2 * K + 1) → ℂ) :
    CCM.poleEvenProfile L K ⬝ᵥ u =
      ((L / (16 * Real.pi ^ 2) : ℝ) : ℂ) * neutralEvenFunctional (neutralPoleParameter L) K u ∧
    CCM.poleOddProfile L K ⬝ᵥ u =
      ((1 / (4 * Real.pi) : ℝ) : ℂ) * neutralOddFunctional (neutralPoleParameter L) K u := by
  have he (n : ℤ) : (CCM.poleEvenProfileReal n L : ℂ) =
      ((L / (16 * Real.pi ^ 2) : ℝ) : ℂ) /
        ((neutralPoleParameter L : ℂ) + (n : ℂ) ^ 2) := by
    have hr : CCM.poleEvenProfileReal n L =
        (L / (16 * Real.pi ^ 2)) / (neutralPoleParameter L + (n : ℝ) ^ 2) := by
      rw [CCM.poleEvenProfileReal, native_profile_denominator, div_div]
    exact_mod_cast hr
  have ho (n : ℤ) : (CCM.poleOddProfileReal n L : ℂ) =
      ((1 / (4 * Real.pi) : ℝ) : ℂ) * (n : ℂ) /
        ((neutralPoleParameter L : ℂ) + (n : ℂ) ^ 2) := by
    have hr : CCM.poleOddProfileReal n L =
        ((1 / (4 * Real.pi)) * (n : ℝ)) /
          (neutralPoleParameter L + (n : ℝ) ^ 2) := by
      rw [CCM.poleOddProfileReal, native_profile_denominator, ← div_div]
      congr 1
      field_simp [Real.pi_ne_zero]
      ring
    exact_mod_cast hr
  constructor
  · unfold dotProduct neutralEvenFunctional CCM.poleEvenProfile
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [he]
    ring
  · unfold dotProduct neutralOddFunctional CCM.poleOddProfile
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [ho]
    ring

/-- Exact native physical moment neutrality, with the original hard window and
normalization and the original exponential-moment scale. -/
theorem neutralRepair_native_moments {L : ℝ} (hL : 0 < L) (K : ℕ) (hK : 2 ≤ K)
    (u : Fin (2 * K + 1) → ℂ) :
    CCM.canonicalPoleExponentialMoment 1 L K (neutralRepair (neutralPoleParameter L) K hK u) = 0 ∧
      CCM.canonicalPoleExponentialMoment (-1) L K (neutralRepair (neutralPoleParameter L) K hK u) = 0 := by
  apply (CCM.canonicalPoleExponentialMoments_iff_profiles hL K _).mpr
  have h := neutralRepair_exact (neutralPoleParameter_pos hL) K hK u
  have hs := neutral_native_profile_scaling L K (neutralRepair (neutralPoleParameter L) K hK u)
  exact ⟨by rw [hs.1,h.1,mul_zero], by rw [hs.2,h.2,mul_zero]⟩

theorem neutralRepair_native_legal_C2 {L : ℝ} (hL : 0 < L) (K : ℕ) (hK : 2 ≤ K)
    (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u) :
    ContDiff ℝ 2 (CCM.localizedFiniteVector L K (neutralRepair (neutralPoleParameter L) K hK u)) :=
  CCM.contDiff_localizedFiniteVector_of_boundaryFlat K _ hL (neutralRepair_legal _ K hK u hu)

/-- The fixed physical topology used by the existing WCONT theorem. -/
def neutralXSize (f : ℝ → ℂ) : ℝ :=
  (∫ x, ‖f x‖) + ∫ x, ‖deriv (deriv f) x‖

theorem neutralXSize_nonneg (f : ℝ → ℂ) : 0 ≤ neutralXSize f :=
  add_nonneg (integral_nonneg fun _ => norm_nonneg _) (integral_nonneg fun _ => norm_nonneg _)

theorem neutralXSize_smul (c : ℂ) (f : ℝ → ℂ) :
    neutralXSize (c • f) = ‖c‖ * neutralXSize f := by
  have he : c • f = fun x => c * f x := rfl
  rw [he]
  unfold neutralXSize
  rw [deriv_const_mul_field',deriv_const_mul_field']
  simp_rw [norm_mul]
  rw [integral_const_mul,integral_const_mul]
  ring

private theorem integral_norm_sub_le {f g : ℝ → ℂ} (hf : Integrable f) (hg : Integrable g) :
    (∫ x, ‖(f - g) x‖) ≤ (∫ x, ‖f x‖) + ∫ x, ‖g x‖ := by
  calc
    _ ≤ ∫ x, ‖f x‖ + ‖g x‖ :=
      integral_mono (hf.sub hg).norm (hf.norm.add hg.norm) (fun x => norm_sub_le (f x) (g x))
    _ = _ := integral_add hf.norm hg.norm

theorem neutralXSize_sub_le {f g : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g) :
    neutralXSize (f - g) ≤ neutralXSize f + neutralXSize g := by
  have hf2 : Continuous (deriv (deriv f)) := by
    have h1 : ContDiff ℝ 1 (deriv f) := by simpa using hf.deriv'
    exact h1.continuous_deriv_one
  have hg2 : Continuous (deriv (deriv g)) := by
    have h1 : ContDiff ℝ 1 (deriv g) := by simpa using hg.deriv'
    exact h1.continuous_deriv_one
  have h0 := integral_norm_sub_le (hf.continuous.integrable_of_hasCompactSupport hfc)
    (hg.continuous.integrable_of_hasCompactSupport hgc)
  have h2 := integral_norm_sub_le (hf2.integrable_of_hasCompactSupport hfc.deriv.deriv)
    (hg2.integrable_of_hasCompactSupport hgc.deriv.deriv)
  unfold neutralXSize
  rw [CCM.deriv_deriv_sub_of_contDiff_two hf hg]
  linarith

def neutralSynthesis (L : ℝ) (K : ℕ) : (Fin (2 * K + 1) → ℂ) →ₗ[ℂ] (ℝ → ℂ) where
  toFun := CCM.localizedFiniteVector L K
  map_add' u v := by
    funext x
    simp [CCM.localizedFiniteVector,add_mul,Finset.sum_add_distrib]
  map_smul' c u := by
    funext x
    simp [CCM.localizedFiniteVector,Finset.mul_sum,Pi.smul_apply,smul_eq_mul,mul_assoc]

/-- Repair uses the same two physical correctors at every bandwidth. -/
theorem neutralRepair_physical (L a : ℝ) (K : ℕ) (hK : 2 ≤ K)
    (u : Fin (2 * K + 1) → ℂ) :
    CCM.localizedFiniteVector L K (neutralRepair a K hK u) =
      CCM.localizedFiniteVector L K u -
        (neutralEvenFunctional a K u / neutralEvenFunctional a 2 CCM.positiveEvenSourceWitness) •
          CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness -
        (neutralOddFunctional a K u / neutralOddFunctional a 2 CCM.oddSourceWitnessK2) •
          CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2 := by
  change neutralSynthesis L K (neutralRepair a K hK u) = _
  unfold neutralRepair
  rw [map_sub,map_sub,map_smul,map_smul]
  simp only [neutralSynthesis,LinearMap.coe_mk,AddHom.coe_mk,neutralEvenCorrector,neutralOddCorrector,
    neutralEvenFunctional_centeredZeroExtend,neutralOddFunctional_centeredZeroExtend,
    CCM.localizedFiniteVector_centeredZeroExtend]

/-- Fixed-L correction cost in the exact physical X topology. This is a
quantitative estimate, rather than a claim that the coefficients are small. -/
theorem neutralRepair_X_cost {L : ℝ} (hL : 0 < L) (a : ℝ) (K : ℕ) (hK : 2 ≤ K)
    (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u)
    {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hfc : HasCompactSupport f) :
    neutralXSize (CCM.localizedFiniteVector L K (neutralRepair a K hK u) - f) ≤
      neutralXSize (CCM.localizedFiniteVector L K u - f) +
        ‖neutralEvenFunctional a K u / neutralEvenFunctional a 2 CCM.positiveEvenSourceWitness‖ *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness) +
        ‖neutralOddFunctional a K u / neutralOddFunctional a 2 CCM.oddSourceWitnessK2‖ *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2) := by
  let ce := neutralEvenFunctional a K u / neutralEvenFunctional a 2 CCM.positiveEvenSourceWitness
  let co := neutralOddFunctional a K u / neutralOddFunctional a 2 CCM.oddSourceWitnessK2
  let e := CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness
  let o := CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2
  let p := CCM.localizedFiniteVector L K u
  have hp : ContDiff ℝ 2 p := CCM.contDiff_localizedFiniteVector_of_boundaryFlat K u hL hu
  have he : ContDiff ℝ 2 e := CCM.contDiff_localizedFiniteVector_of_boundaryFlat 2 _ hL neutral_correctors_legal.1
  have ho : ContDiff ℝ 2 o := CCM.contDiff_localizedFiniteVector_of_boundaryFlat 2 _ hL neutral_correctors_legal.2
  have hpc : HasCompactSupport p := CCM.localizedFiniteVector_hasCompactSupport L K u
  have hec : HasCompactSupport e := CCM.localizedFiniteVector_hasCompactSupport L 2 _
  have hoc : HasCompactSupport o := CCM.localizedFiniteVector_hasCompactSupport L 2 _
  have hce : ContDiff ℝ 2 (ce • e) := he.const_smul ce
  have hco : ContDiff ℝ 2 (co • o) := ho.const_smul co
  have hcec : HasCompactSupport (ce • e) := by
    exact HasCompactSupport.smul_left (f := fun _ : ℝ => ce) hec
  have hcoc : HasCompactSupport (co • o) := by
    exact HasCompactSupport.smul_left (f := fun _ : ℝ => co) hoc
  have h1 := neutralXSize_sub_le (hp.sub hf) hce (hpc.sub hfc) hcec
  have h2 := neutralXSize_sub_le ((hp.sub hf).sub hce) hco ((hpc.sub hfc).sub hcec) hcoc
  rw [neutralXSize_smul] at h1 h2
  rw [neutralRepair_physical]
  have hx : p - ce • e - co • o - f = (p - f) - ce • e - co • o := by abel
  change neutralXSize (p - ce • e - co • o - f) ≤ _
  rw [hx]
  change neutralXSize ((p - f) - ce • e - co • o) ≤
    neutralXSize (p - f) + ‖ce‖ * neutralXSize e + ‖co‖ * neutralXSize o
  change neutralXSize ((p - f) - ce • e) ≤ neutralXSize (p - f) + ‖ce‖ * neutralXSize e at h1
  change neutralXSize ((p - f) - ce • e - co • o) ≤ neutralXSize ((p - f) - ce • e) + ‖co‖ * neutralXSize o at h2
  exact h2.trans (add_le_add h1 (le_refl _))

def neutralPhysicalMoment (σ : ℝ) (f : ℝ → ℂ) : ℂ :=
  ∫ x : ℝ, (Real.exp (σ * x / 2) : ℂ) * f x

theorem neutralPhysicalMoment_finite (σ L : ℝ) (K : ℕ) (u : Fin (2 * K + 1) → ℂ) :
    neutralPhysicalMoment σ (CCM.localizedFiniteVector L K u) =
      CCM.canonicalPoleExponentialMoment σ L K u := rfl

theorem neutralPhysicalMoment_sub {f g : ℝ → ℂ} (hf : Continuous f) (hg : Continuous g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g) (σ : ℝ) :
    neutralPhysicalMoment σ (f - g) = neutralPhysicalMoment σ f - neutralPhysicalMoment σ g := by
  have hfi : Integrable (fun x : ℝ => (Real.exp (σ * x / 2) : ℂ) * f x) :=
    (by fun_prop : Continuous (fun x : ℝ => (Real.exp (σ * x / 2) : ℂ) * f x)).integrable_of_hasCompactSupport hfc.mul_left
  have hgi : Integrable (fun x : ℝ => (Real.exp (σ * x / 2) : ℂ) * g x) :=
    (by fun_prop : Continuous (fun x : ℝ => (Real.exp (σ * x / 2) : ℂ) * g x)).integrable_of_hasCompactSupport hgc.mul_left
  unfold neutralPhysicalMoment
  simp_rw [Pi.sub_apply,mul_sub]
  exact integral_sub hfi hgi

/-- Exponential moments are continuous in the same source's fixed-aperture L1
error, with a finite constant depending only on the aperture. -/
theorem neutralPhysicalMoment_error_bound {L : ℝ} (hL : 0 < L) {f g : ℝ → ℂ}
    (hf : Continuous f) (hg : Continuous g) (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hfs : Function.support f ⊆ Icc (0 : ℝ) L) (hgs : Function.support g ⊆ Icc (0 : ℝ) L)
    (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) :
    ‖neutralPhysicalMoment σ f - neutralPhysicalMoment σ g‖ ≤
      Real.exp (L / 2) * ∫ x : ℝ, ‖(f - g) x‖ := by
  rw [← neutralPhysicalMoment_sub hf hg hfc hgc]
  let e := f - g
  have he : Continuous e := hf.sub hg
  have hec : HasCompactSupport e := hfc.sub hgc
  have hes : Function.support e ⊆ Icc (0 : ℝ) L := by
    intro x hx
    by_cases hfx : f x = 0
    · apply hgs
      intro hgx
      exact hx (by simp [e,hfx,hgx])
    · exact hfs hfx
  have hwi : Integrable (fun x : ℝ => (Real.exp (σ * x / 2) : ℂ) * e x) :=
    (by fun_prop : Continuous (fun x : ℝ => (Real.exp (σ * x / 2) : ℂ) * e x)).integrable_of_hasCompactSupport hec.mul_left
  change ‖∫ x : ℝ, (Real.exp (σ * x / 2) : ℂ) * e x‖ ≤ _
  calc
    _ ≤ ∫ x : ℝ, ‖(Real.exp (σ * x / 2) : ℂ) * e x‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ x : ℝ, Real.exp (L / 2) * ‖e x‖ := by
      apply integral_mono hwi.norm ((he.integrable_of_hasCompactSupport hec).norm.const_mul _)
      intro x
      by_cases hex : e x = 0
      · simp [hex]
      · have hs := hes hex
        change ‖(Real.exp (σ * x / 2) : ℂ) * e x‖ ≤ Real.exp (L / 2) * ‖e x‖
        rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (Real.exp_pos _)]
        apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
        apply Real.exp_le_exp.mpr
        rcases hσ with rfl | rfl <;> nlinarith [hs.1,hs.2]
    _ = _ := integral_const_mul _ _

theorem neutral_native_profiles_from_moments {L : ℝ} (hL : 0 < L)
    (K : ℕ) (u : Fin (2 * K + 1) → ℂ) :
    CCM.poleEvenProfile L K ⬝ᵥ u =
      (CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L -
        CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L) / 2 ∧
    CCM.poleOddProfile L K ⬝ᵥ u = (Complex.I / 2) *
      (CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L +
        CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L) := by
  rw [CCM.canonicalPoleExponentialMoment_eq_profiles hL 1 K u (Or.inl rfl),
    CCM.canonicalPoleExponentialMoment_eq_profiles hL (-1) K u (Or.inr rfl)]
  rw [mul_div_cancel_left₀ _ (CCM.canonicalPoleExponentialMomentScale_ne_zero hL 1 (Or.inl rfl)),
    mul_div_cancel_left₀ _ (CCM.canonicalPoleExponentialMomentScale_ne_zero hL (-1) (Or.inr rfl))]
  norm_num
  ring_nf
  simp [Complex.I_sq]

/-- Exact neutral repair is continuous at every fixed-aperture neutral target
in the very X topology supplied by the existing finite approximation theorem. -/
theorem neutralRepair_tendsto_X {L : ℝ} (hL : 0 < L)
    (K : ℕ → ℕ) (hK : ∀ n, 2 ≤ K n)
    (u : (n : ℕ) → Fin (2 * K n + 1) → ℂ)
    (hu : ∀ n, CCM.BoundaryFlatCoefficients (K n) (u n))
    {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hfc : HasCompactSupport f)
    (hfs : Function.support f ⊆ Icc (0 : ℝ) L)
    (hfzero : neutralPhysicalMoment 1 f = 0 ∧ neutralPhysicalMoment (-1) f = 0)
    (hX : Tendsto (fun n => neutralXSize (CCM.localizedFiniteVector L (K n) (u n) - f)) atTop (𝓝 0)) :
    Tendsto (fun n => neutralXSize (CCM.localizedFiniteVector L (K n)
      (neutralRepair (neutralPoleParameter L) (K n) (hK n) (u n)) - f)) atTop (𝓝 0) := by
  let p := fun n => CCM.localizedFiniteVector L (K n) (u n)
  have hp (n) : ContDiff ℝ 2 (p n) := CCM.contDiff_localizedFiniteVector_of_boundaryFlat (K n) (u n) hL (hu n)
  have hpc (n) : HasCompactSupport (p n) := CCM.localizedFiniteVector_hasCompactSupport L (K n) (u n)
  have hps (n) : Function.support (p n) ⊆ Icc (0 : ℝ) L := CCM.localizedFiniteVector_support_subset L (K n) (u n)
  have hL1 : Tendsto (fun n => ∫ x : ℝ, ‖(p n - f) x‖) atTop (𝓝 0) := by
    apply squeeze_zero (fun n => integral_nonneg (fun _ => norm_nonneg _)) _ hX
    intro n
    exact le_add_of_nonneg_right (integral_nonneg (fun _ => norm_nonneg _))
  have hm (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (hzero : neutralPhysicalMoment σ f = 0) :
      Tendsto (fun n => CCM.canonicalPoleExponentialMoment σ L (K n) (u n)) atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    have hupper : Tendsto (fun n => Real.exp (L / 2) * ∫ x : ℝ, ‖(p n - f) x‖) atTop (𝓝 0) := by
      simpa using hL1.const_mul (Real.exp (L / 2))
    apply squeeze_zero (fun _ => norm_nonneg _) _ hupper
    intro n
    have hb := neutralPhysicalMoment_error_bound hL (hp n).continuous hf.continuous (hpc n) hfc (hps n) hfs σ hσ
    simpa only [p,hzero,sub_zero,neutralPhysicalMoment_finite] using hb
  have hplus := hm 1 (Or.inl rfl) hfzero.1
  have hminus := hm (-1) (Or.inr rfl) hfzero.2
  have hE : Tendsto (fun n => CCM.poleEvenProfile L (K n) ⬝ᵥ u n) atTop (𝓝 0) := by
    have heq : (fun n => CCM.poleEvenProfile L (K n) ⬝ᵥ u n) = fun n =>
        (CCM.canonicalPoleExponentialMoment 1 L (K n) (u n) / CCM.canonicalPoleExponentialMomentScale 1 L -
          CCM.canonicalPoleExponentialMoment (-1) L (K n) (u n) / CCM.canonicalPoleExponentialMomentScale (-1) L) / 2 := by
      funext n
      exact (neutral_native_profiles_from_moments hL (K n) (u n)).1
    rw [heq]
    simpa using ((hplus.div_const _).sub (hminus.div_const _)).div_const (2 : ℂ)
  have hO : Tendsto (fun n => CCM.poleOddProfile L (K n) ⬝ᵥ u n) atTop (𝓝 0) := by
    have heq : (fun n => CCM.poleOddProfile L (K n) ⬝ᵥ u n) = fun n => (Complex.I / 2) *
        (CCM.canonicalPoleExponentialMoment 1 L (K n) (u n) / CCM.canonicalPoleExponentialMomentScale 1 L +
          CCM.canonicalPoleExponentialMoment (-1) L (K n) (u n) / CCM.canonicalPoleExponentialMomentScale (-1) L) := by
      funext n
      exact (neutral_native_profiles_from_moments hL (K n) (u n)).2
    rw [heq]
    simpa using ((hplus.div_const _).add (hminus.div_const _)).const_mul (Complex.I / 2)
  let cE : ℂ := ((L / (16 * Real.pi ^ 2) : ℝ) : ℂ)
  let cO : ℂ := ((1 / (4 * Real.pi) : ℝ) : ℂ)
  have hcE : cE ≠ 0 := by
    apply Complex.ofReal_ne_zero.mpr
    exact div_ne_zero hL.ne' (by positivity)
  have hcO : cO ≠ 0 := by
    apply Complex.ofReal_ne_zero.mpr
    exact div_ne_zero one_ne_zero (by positivity)
  have hellE : Tendsto (fun n => neutralEvenFunctional (neutralPoleParameter L) (K n) (u n)) atTop (𝓝 0) := by
    have heq : (fun n => neutralEvenFunctional (neutralPoleParameter L) (K n) (u n)) =
        fun n => (CCM.poleEvenProfile L (K n) ⬝ᵥ u n) / cE := by
      funext n
      rw [(neutral_native_profile_scaling L (K n) (u n)).1]
      exact (mul_div_cancel_left₀ _ hcE).symm
    rw [heq]
    simpa using hE.div_const cE
  have hellO : Tendsto (fun n => neutralOddFunctional (neutralPoleParameter L) (K n) (u n)) atTop (𝓝 0) := by
    have heq : (fun n => neutralOddFunctional (neutralPoleParameter L) (K n) (u n)) =
        fun n => (CCM.poleOddProfile L (K n) ⬝ᵥ u n) / cO := by
      funext n
      rw [(neutral_native_profile_scaling L (K n) (u n)).2]
      exact (mul_div_cancel_left₀ _ hcO).symm
    rw [heq]
    simpa using hO.div_const cO
  have hce := hellE.div_const (neutralEvenFunctional (neutralPoleParameter L) 2 CCM.positiveEvenSourceWitness)
  have hco := hellO.div_const (neutralOddFunctional (neutralPoleParameter L) 2 CCM.oddSourceWitnessK2)
  have hupper : Tendsto (fun n => neutralXSize (p n - f) +
      ‖neutralEvenFunctional (neutralPoleParameter L) (K n) (u n) /
        neutralEvenFunctional (neutralPoleParameter L) 2 CCM.positiveEvenSourceWitness‖ *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness) +
      ‖neutralOddFunctional (neutralPoleParameter L) (K n) (u n) /
        neutralOddFunctional (neutralPoleParameter L) 2 CCM.oddSourceWitnessK2‖ *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2)) atTop (𝓝 0) := by
    simpa using (hX.add (hce.norm.mul_const (neutralXSize (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness)))).add
      (hco.norm.mul_const (neutralXSize (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2)))
  exact squeeze_zero (fun n => neutralXSize_nonneg _) (fun n =>
    neutralRepair_X_cost hL (neutralPoleParameter L) (K n) (hK n) (u n) (hu n) hf hfc) hupper

theorem neutralPhysicalMoment_eq_paperFT (σ : ℝ) (f : ℝ → ℂ) :
    neutralPhysicalMoment σ f = Zeta23.paperFT f (((-σ / 2 : ℝ) : ℂ) * Complex.I) := by
  unfold neutralPhysicalMoment Zeta23.paperFT
  apply integral_congr_ae
  filter_upwards with x
  have he : Complex.I * (((-σ / 2 : ℝ) : ℂ) * Complex.I) * (x : ℂ) =
      ((σ * x / 2 : ℝ) : ℂ) := by
    push_cast
    calc
      _ = -(σ : ℂ) / 2 * (Complex.I * Complex.I) * (x : ℂ) := by ring
      _ = _ := by rw [Complex.I_mul_I]; ring
  rw [he,← Complex.ofReal_exp]
  ring

theorem neutralPhysicalMoments_zero_of_paperFT {f : ℝ → ℂ}
    (hp : Zeta23.paperFT f (Complex.I / 2) = 0)
    (hm : Zeta23.paperFT f (-Complex.I / 2) = 0) :
    neutralPhysicalMoment 1 f = 0 ∧ neutralPhysicalMoment (-1) f = 0 := by
  have h1 : (((-(1 : ℝ) / 2 : ℝ) : ℂ) * Complex.I) = -Complex.I / 2 := by push_cast; ring
  have h2 : (((-(-1 : ℝ) / 2 : ℝ) : ℂ) * Complex.I) = Complex.I / 2 := by push_cast; ring
  exact ⟨by rw [neutralPhysicalMoment_eq_paperFT,h1,hm],
    by rw [neutralPhysicalMoment_eq_paperFT,h2,hp]⟩

/-- A neutral compact strict-collar target has genuinely legal finite neutral
approximants in the original hard-window X topology, at every fixed aperture. -/
theorem exists_finite_neutral_X_approx {L : ℝ} (hL : 0 < L)
    {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hfc : HasCompactSupport f)
    (hfs : tsupport f ⊆ Ioo (0 : ℝ) L)
    (hfzero : neutralPhysicalMoment 1 f = 0 ∧ neutralPhysicalMoment (-1) f = 0)
    {η : ℝ} (hη : 0 < η) :
    ∃ K : ℕ, 3 ≤ K ∧ ∃ u : Fin (2 * K + 1) → ℂ,
      CCM.BoundaryFlatCoefficients K u ∧
      CCM.canonicalPoleExponentialMoment 1 L K u = 0 ∧
      CCM.canonicalPoleExponentialMoment (-1) L K u = 0 ∧
      neutralXSize (CCM.localizedFiniteVector L K u - f) < η := by
  classical
  let ε := fun n : ℕ => 1 / ((n : ℝ) + 1)
  have hex (n : ℕ) := CCM.exists_boundaryFlatFinite_WCONT_approx hL hf hfs
    (show 0 < ε n by dsimp [ε]; positivity)
  choose N hN u hu he0 he2 using hex
  let K := fun n => max 3 (N n)
  let v := fun n => CCM.centeredZeroExtend (show N n ≤ K n from le_max_right _ _) (u n)
  have hK3 (n) : 3 ≤ K n := le_max_left _ _
  have hK2 (n) : 2 ≤ K n := by have := hK3 n; omega
  have hv (n) : CCM.BoundaryFlatCoefficients (K n) (v n) :=
    CCM.centeredZeroExtend_boundaryFlat (show N n ≤ K n from le_max_right _ _) (hu n)
  have hphysical (n) : CCM.localizedFiniteVector L (K n) (v n) = CCM.localizedFiniteVector L (N n) (u n) :=
    CCM.localizedFiniteVector_centeredZeroExtend L (show N n ≤ K n from le_max_right _ _) (u n)
  have hbefore : Tendsto (fun n => neutralXSize (CCM.localizedFiniteVector L (K n) (v n) - f)) atTop (𝓝 0) := by
    have hlim : Tendsto (fun n => 2 * ε n) atTop (𝓝 0) := by
      simpa [ε] using (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul 2
    apply squeeze_zero (fun n => neutralXSize_nonneg _) _ hlim
    intro n
    rw [hphysical]
    unfold neutralXSize
    have h0 := he0 n
    have h2 := he2 n
    linarith
  have hs : Function.support f ⊆ Icc (0 : ℝ) L := by
    intro x hx
    have hi := hfs (subset_tsupport f hx)
    exact ⟨hi.1.le,hi.2.le⟩
  have hafter := neutralRepair_tendsto_X hL K hK2 v hv hf hfc hs hfzero hbefore
  obtain ⟨n,hn⟩ := ((tendsto_order.mp hafter).2 η hη).exists
  refine ⟨K n,hK3 n,neutralRepair (neutralPoleParameter L) (K n) (hK2 n) (v n),
    neutralRepair_legal _ _ _ _ (hv n),?_,?_,hn⟩
  · exact (neutralRepair_native_moments hL _ _ _).1
  · exact (neutralRepair_native_moments hL _ _ _).2

/-- Strict genuine Weil negativity survives exact neutral finite repair. -/
theorem exists_finite_neutral_negative_of_strict_aperture {L : ℝ} (hL : 0 < L)
    {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hfc : HasCompactSupport f)
    (hfs : tsupport f ⊆ Ioo (0 : ℝ) L)
    (hp : Zeta23.paperFT f (Complex.I / 2) = 0)
    (hm : Zeta23.paperFT f (-Complex.I / 2) = 0)
    (hneg : (zetaZeroConfig.W f f).re < 0) :
    ∃ K : ℕ, 3 ≤ K ∧ ∃ u : Fin (2 * K + 1) → ℂ,
      CCM.BoundaryFlatCoefficients K u ∧
      CCM.canonicalPoleExponentialMoment 1 L K u = 0 ∧
      CCM.canonicalPoleExponentialMoment (-1) L K u = 0 ∧ u ≠ 0 ∧
      (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) u).re < 0 := by
  let m := -(zetaZeroConfig.W f f).re
  let C := Real.exp L * ExceptionalZero.zetaInvSqZeroMass *
    (3 * (∫ x : ℝ, ‖f x‖) + (∫ x : ℝ, ‖deriv (deriv f) x‖) + 2)
  let η := min 1 (m / (2 * (C + 1)))
  have hmpos : 0 < m := neg_pos.mpr hneg
  have h0nonneg : 0 ≤ ∫ x : ℝ, ‖f x‖ := integral_nonneg fun _ => norm_nonneg _
  have h2nonneg : 0 ≤ ∫ x : ℝ, ‖deriv (deriv f) x‖ := integral_nonneg fun _ => norm_nonneg _
  have hC : 0 ≤ C := by
    apply mul_nonneg
    · exact mul_nonneg (Real.exp_pos L).le ExceptionalZero.zetaInvSqZeroMass_nonneg
    · linarith
  have hd : 0 < 2 * (C + 1) := by linarith
  have hη : 0 < η := lt_min (by norm_num) (div_pos hmpos hd)
  have hη1 : η ≤ 1 := min_le_left _ _
  have hηsmall : η * (2 * (C + 1)) ≤ m :=
    (le_div_iff₀ hd).mp (min_le_right _ _)
  have hmargin : C * η < m := by nlinarith
  obtain ⟨K,hK,u,hu,hup,hum,hX⟩ := exists_finite_neutral_X_approx hL hf hfc hfs
    (neutralPhysicalMoments_zero_of_paperFT hp hm) hη
  let p := CCM.localizedFiniteVector L K u
  have hpc2 : ContDiff ℝ 2 p := CCM.contDiff_localizedFiniteVector_of_boundaryFlat K u hL hu
  have hps : ∀ x, p x ≠ 0 → |x| ≤ L := by
    intro x hx
    have hi := CCM.localizedFiniteVector_support_subset L K u hx
    rw [abs_of_nonneg hi.1]
    exact hi.2
  have hfs' : ∀ x, f x ≠ 0 → |x| ≤ L := by
    intro x hx
    have hi := hfs (subset_tsupport f hx)
    rw [abs_of_pos hi.1]
    exact hi.2.le
  have he0 : (∫ x : ℝ, ‖(p - f) x‖) ≤ η := by
    exact (le_add_of_nonneg_right (integral_nonneg fun _ => norm_nonneg _)).trans hX.le
  have he2 : (∫ x : ℝ, ‖deriv (deriv (p - f)) x‖) ≤ η := by
    exact (le_add_of_nonneg_left (integral_nonneg fun _ => norm_nonneg _)).trans hX.le
  have hW := ExceptionalZero.zeta_W_self_sub_self_norm_le_of_WCONT_errors
    hL hη.le hη1 hpc2 hf hps hfs' he0 he2
  have hWbound : ‖zetaZeroConfig.W p p - zetaZeroConfig.W f f‖ ≤ C * η := by
    calc
      _ ≤ Real.exp L * ExceptionalZero.zetaInvSqZeroMass * η *
          (3 * (∫ x : ℝ, ‖f x‖) + (∫ x : ℝ, ‖deriv (deriv f) x‖) + 2) := hW
      _ = C * η := by dsimp [C]; ring
  have hWlt := hWbound.trans_lt hmargin
  have hre := (le_abs_self (zetaZeroConfig.W p p - zetaZeroConfig.W f f).re).trans
    (Complex.abs_re_le_norm (zetaZeroConfig.W p p - zetaZeroConfig.W f f))
  have hpneg : (zetaZeroConfig.W p p).re < 0 := by
    change (zetaZeroConfig.W p p).re - (zetaZeroConfig.W f f).re ≤ _ at hre
    dsimp [m] at hWlt
    linarith
  have hQ : (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) u).re < 0 := by
    rw [← ExceptionalZero.zeta_W_boundaryFlatFiniteVector_eq_canonicalSourceQuadraticForm K u hL hu]
    exact hpneg
  have hune : u ≠ 0 := by
    intro hz
    rw [hz,CCM.quadraticForm_zero,Complex.zero_re] at hQ
    exact (lt_irrefl 0) hQ
  exact ⟨K,hK,u,hu,hup,hum,hune,hQ⟩

/-- One reflection parity is negative; no chosen parity or simultaneous
negativity is asserted. -/
theorem neutral_negative_parity_split (L : ℝ) (K : ℕ) (u : Fin (2 * K + 1) → ℂ)
    (hneg : (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) u).re < 0) :
    (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) (CCM.evenPart K u)).re < 0 ∨
      (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) (CCM.oddPart K u)).re < 0 := by
  have hs := congrArg Complex.re (CCM.quadraticForm_evenPart_add_oddPart L K u)
  simp only [Complex.add_re] at hs
  by_contra! hn
  linarith

theorem eventually_finite_neutral_negative_of_off_line_zero
    (ρ : zetaZeroConfig.carrier) (hoff : (ρ : ℂ).re ≠ 1 / 2) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ < L →
      ∃ K : ℕ, 3 ≤ K ∧ ∃ u : Fin (2 * K + 1) → ℂ,
        u ≠ 0 ∧ CCM.BoundaryFlatCoefficients K u ∧
        CCM.canonicalPoleExponentialMoment 1 L K u = 0 ∧
        CCM.canonicalPoleExponentialMoment (-1) L K u = 0 ∧
        (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) u).re < 0 ∧
        ((CCM.quadraticForm (CCM.canonicalSourceMatrix L K) (CCM.evenPart K u)).re < 0 ∨
          (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) (CCM.oddPart K u)).re < 0) := by
  obtain ⟨_L,_hL,r,hr,_hLr,f,hf,hfc,hmargin,_hfs,hp,hm,hneg⟩ :=
    ExceptionalZero.exists_strictAperture_poleNeutral_negativeWeilTest_of_offLine_zero ρ hoff
  refine ⟨4 * r,by positivity,?_⟩
  intro L hLbig
  have hL : 0 < L := by nlinarith
  have hs : tsupport f ⊆ Ioo (0 : ℝ) L := by
    intro x hx
    have hi := hmargin hx
    exact ⟨by linarith [hi.1],by linarith [hi.2]⟩
  obtain ⟨K,hK,u,hu,hup,hum,hune,hQ⟩ :=
    exists_finite_neutral_negative_of_strict_aperture hL hf hfc hs hp hm hneg
  exact ⟨K,hK,u,hune,hu,hup,hum,hQ,neutral_negative_parity_split L K u hQ⟩

/-- The actual off-line-zero obstruction has a nonzero legal neutral finite
realization at every sufficiently large aperture. This constructs obstructions;
it supplies no independent no-exit sign and does not prove RH. -/
theorem finite_pole_neutral_approximation (hnot : ¬ RiemannHypothesis) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ < L →
      ∃ K : ℕ, 3 ≤ K ∧ ∃ u : Fin (2 * K + 1) → ℂ,
        u ≠ 0 ∧ CCM.BoundaryFlatCoefficients K u ∧
        CCM.canonicalPoleExponentialMoment 1 L K u = 0 ∧
        CCM.canonicalPoleExponentialMoment (-1) L K u = 0 ∧
        (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) u).re < 0 ∧
        ((CCM.quadraticForm (CCM.canonicalSourceMatrix L K) (CCM.evenPart K u)).re < 0 ∨
          (CCM.quadraticForm (CCM.canonicalSourceMatrix L K) (CCM.oddPart K u)).re < 0) := by
  have hex : ∃ ρ : zetaZeroConfig.carrier, (ρ : ℂ).re ≠ 1 / 2 := by
    by_contra! hno
    apply hnot
    intro s hz htriv hs1
    have hs : IsNontrivialZero s := ExceptionalZero.isNontrivialZero_of_mathlib_nontrivialZero hz htriv hs1
    exact hno ⟨s,by simpa using hs⟩
  obtain ⟨ρ,hoff⟩ := hex
  exact eventually_finite_neutral_negative_of_off_line_zero ρ hoff

def neutralMomentAmplification (L : ℝ) : ℝ :=
  Real.exp (L / 2) * ((‖CCM.canonicalPoleExponentialMomentScale 1 L‖)⁻¹ +
    (‖CCM.canonicalPoleExponentialMomentScale (-1) L‖)⁻¹)

def neutralEvenRepairAmplification (L : ℝ) : ℝ :=
  neutralMomentAmplification L / ‖((L / (16 * Real.pi ^ 2) : ℝ) : ℂ)‖ /
    ‖neutralEvenFunctional (neutralPoleParameter L) 2 CCM.positiveEvenSourceWitness‖

def neutralOddRepairAmplification (L : ℝ) : ℝ :=
  neutralMomentAmplification L / ‖((1 / (4 * Real.pi) : ℝ) : ℂ)‖ /
    ‖neutralOddFunctional (neutralPoleParameter L) 2 CCM.oddSourceWitnessK2‖

def neutralRepairXBound (L : ℝ) : ℝ := 1 +
  neutralEvenRepairAmplification L * neutralXSize (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness) +
  neutralOddRepairAmplification L * neutralXSize (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2)

private theorem native_profiles_error_bound {L : ℝ} (hL : 0 < L)
    (K : ℕ) (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u)
    {f : ℝ → ℂ} (hf : Continuous f) (hfc : HasCompactSupport f)
    (hfs : Function.support f ⊆ Icc (0 : ℝ) L)
    (hfzero : neutralPhysicalMoment 1 f = 0 ∧ neutralPhysicalMoment (-1) f = 0) :
    ‖CCM.poleEvenProfile L K ⬝ᵥ u‖ ≤ neutralMomentAmplification L *
        (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖) ∧
      ‖CCM.poleOddProfile L K ⬝ᵥ u‖ ≤ neutralMomentAmplification L *
        (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖) := by
  let p := CCM.localizedFiniteVector L K u
  let err := ∫ x : ℝ, ‖(p - f) x‖
  have hp : Continuous p := (CCM.contDiff_localizedFiniteVector_of_boundaryFlat K u hL hu).continuous
  have hpc := CCM.localizedFiniteVector_hasCompactSupport L K u
  have hps := CCM.localizedFiniteVector_support_subset L K u
  have hb (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (hz : neutralPhysicalMoment σ f = 0) :
      ‖CCM.canonicalPoleExponentialMoment σ L K u‖ ≤ Real.exp (L / 2) * err := by
    simpa only [p,hz,sub_zero,neutralPhysicalMoment_finite] using
      neutralPhysicalMoment_error_bound hL hp hf hpc hfc hps hfs σ hσ
  have hdiv (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (hz : neutralPhysicalMoment σ f = 0) :
      ‖CCM.canonicalPoleExponentialMoment σ L K u / CCM.canonicalPoleExponentialMomentScale σ L‖ ≤
        (Real.exp (L / 2) / ‖CCM.canonicalPoleExponentialMomentScale σ L‖) * err := by
    rw [norm_div]
    calc
      _ ≤ (Real.exp (L / 2) * err) / ‖CCM.canonicalPoleExponentialMomentScale σ L‖ :=
        div_le_div_of_nonneg_right (hb σ hσ hz) (norm_nonneg _)
      _ = _ := by ring
  have hs : ‖CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L‖ +
      ‖CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L‖ ≤
        neutralMomentAmplification L * err := by
    calc
      _ ≤ (Real.exp (L / 2) / ‖CCM.canonicalPoleExponentialMomentScale 1 L‖) * err +
          (Real.exp (L / 2) / ‖CCM.canonicalPoleExponentialMomentScale (-1) L‖) * err :=
        add_le_add (hdiv 1 (Or.inl rfl) hfzero.1) (hdiv (-1) (Or.inr rfl) hfzero.2)
      _ = _ := by unfold neutralMomentAmplification; simp only [div_eq_mul_inv]; ring
  have hi := neutral_native_profiles_from_moments hL K u
  constructor
  · rw [hi.1,norm_div]
    have htwo : ‖(2 : ℂ)‖ = (2 : ℝ) := by norm_num
    rw [htwo]
    calc
      _ ≤ ‖CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L -
          CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L‖ := by
        nlinarith [norm_nonneg (CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L -
          CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L)]
      _ ≤ _ := (norm_sub_le _ _).trans hs
  · rw [hi.2,norm_mul]
    have hhalf : ‖(Complex.I / 2 : ℂ)‖ = (1 / 2 : ℝ) := by norm_num
    rw [hhalf]
    calc
      _ ≤ ‖CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L +
          CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L‖ := by
        nlinarith [norm_nonneg (CCM.canonicalPoleExponentialMoment 1 L K u / CCM.canonicalPoleExponentialMomentScale 1 L +
          CCM.canonicalPoleExponentialMoment (-1) L K u / CCM.canonicalPoleExponentialMomentScale (-1) L)]
      _ ≤ _ := (norm_add_le _ _).trans hs

theorem neutralRepair_coefficient_bounds {L : ℝ} (hL : 0 < L)
    (K : ℕ) (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u)
    {f : ℝ → ℂ} (hf : Continuous f) (hfc : HasCompactSupport f)
    (hfs : Function.support f ⊆ Icc (0 : ℝ) L)
    (hfzero : neutralPhysicalMoment 1 f = 0 ∧ neutralPhysicalMoment (-1) f = 0) :
    ‖neutralEvenFunctional (neutralPoleParameter L) K u /
      neutralEvenFunctional (neutralPoleParameter L) 2 CCM.positiveEvenSourceWitness‖ ≤
      neutralEvenRepairAmplification L * (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖) ∧
    ‖neutralOddFunctional (neutralPoleParameter L) K u /
      neutralOddFunctional (neutralPoleParameter L) 2 CCM.oddSourceWitnessK2‖ ≤
      neutralOddRepairAmplification L * (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖) := by
  have hb := native_profiles_error_bound hL K u hu hf hfc hfs hfzero
  let cE : ℂ := ((L / (16 * Real.pi ^ 2) : ℝ) : ℂ)
  let cO : ℂ := ((1 / (4 * Real.pi) : ℝ) : ℂ)
  have hcE : cE ≠ 0 := Complex.ofReal_ne_zero.mpr (div_ne_zero hL.ne' (by positivity))
  have hcO : cO ≠ 0 := Complex.ofReal_ne_zero.mpr (div_ne_zero one_ne_zero (by positivity))
  have he : neutralEvenFunctional (neutralPoleParameter L) K u = (CCM.poleEvenProfile L K ⬝ᵥ u) / cE := by
    rw [(neutral_native_profile_scaling L K u).1]
    exact (mul_div_cancel_left₀ _ hcE).symm
  have ho : neutralOddFunctional (neutralPoleParameter L) K u = (CCM.poleOddProfile L K ⬝ᵥ u) / cO := by
    rw [(neutral_native_profile_scaling L K u).2]
    exact (mul_div_cancel_left₀ _ hcO).symm
  constructor
  · rw [he,norm_div,norm_div]
    calc
      _ ≤ (neutralMomentAmplification L * (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖)) / ‖cE‖ /
          ‖neutralEvenFunctional (neutralPoleParameter L) 2 CCM.positiveEvenSourceWitness‖ :=
        div_le_div_of_nonneg_right (div_le_div_of_nonneg_right hb.1 (norm_nonneg _)) (norm_nonneg _)
      _ = _ := by dsimp [neutralEvenRepairAmplification,cE]; simp only [div_eq_mul_inv]; ring
  · rw [ho,norm_div,norm_div]
    calc
      _ ≤ (neutralMomentAmplification L * (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖)) / ‖cO‖ /
          ‖neutralOddFunctional (neutralPoleParameter L) 2 CCM.oddSourceWitnessK2‖ :=
        div_le_div_of_nonneg_right (div_le_div_of_nonneg_right hb.2 (norm_nonneg _)) (norm_nonneg _)
      _ = _ := by dsimp [neutralOddRepairAmplification,cO]; simp only [div_eq_mul_inv]; ring

/-- A positive finite C_L depends only on the fixed aperture, never on K or the
approximating vector. Both native moments and the exact physical X norm remain
visible. No uniform-in-L or effective cutoff estimate is asserted. -/
theorem neutralRepair_X_bound_fixed_aperture {L : ℝ} (hL : 0 < L)
    (K : ℕ) (hK : 2 ≤ K) (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u)
    {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) (hfc : HasCompactSupport f)
    (hfs : Function.support f ⊆ Icc (0 : ℝ) L)
    (hfzero : neutralPhysicalMoment 1 f = 0 ∧ neutralPhysicalMoment (-1) f = 0) :
    0 < neutralRepairXBound L ∧
      neutralXSize (CCM.localizedFiniteVector L K (neutralRepair (neutralPoleParameter L) K hK u) - f) ≤
        neutralRepairXBound L * neutralXSize (CCM.localizedFiniteVector L K u - f) := by
  have hD : 0 ≤ neutralMomentAmplification L := by unfold neutralMomentAmplification; positivity
  have hE : 0 ≤ neutralEvenRepairAmplification L := by unfold neutralEvenRepairAmplification; positivity
  have hO : 0 ≤ neutralOddRepairAmplification L := by unfold neutralOddRepairAmplification; positivity
  have hXE := neutralXSize_nonneg (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness)
  have hXO := neutralXSize_nonneg (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2)
  constructor
  · unfold neutralRepairXBound
    nlinarith [mul_nonneg hE hXE,mul_nonneg hO hXO]
  have hb := neutralRepair_coefficient_bounds hL K u hu hf.continuous hfc hfs hfzero
  have h0 : (∫ x : ℝ, ‖(CCM.localizedFiniteVector L K u - f) x‖) ≤
      neutralXSize (CCM.localizedFiniteVector L K u - f) :=
    le_add_of_nonneg_right (integral_nonneg fun _ => norm_nonneg _)
  have he := hb.1.trans (mul_le_mul_of_nonneg_left h0 hE)
  have ho := hb.2.trans (mul_le_mul_of_nonneg_left h0 hO)
  calc
    _ ≤ neutralXSize (CCM.localizedFiniteVector L K u - f) +
        ‖neutralEvenFunctional (neutralPoleParameter L) K u / neutralEvenFunctional (neutralPoleParameter L) 2 CCM.positiveEvenSourceWitness‖ *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness) +
        ‖neutralOddFunctional (neutralPoleParameter L) K u / neutralOddFunctional (neutralPoleParameter L) 2 CCM.oddSourceWitnessK2‖ *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2) := neutralRepair_X_cost hL _ K hK u hu hf hfc
    _ ≤ neutralXSize (CCM.localizedFiniteVector L K u - f) +
        (neutralEvenRepairAmplification L * neutralXSize (CCM.localizedFiniteVector L K u - f)) *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.positiveEvenSourceWitness) +
        (neutralOddRepairAmplification L * neutralXSize (CCM.localizedFiniteVector L K u - f)) *
          neutralXSize (CCM.localizedFiniteVector L 2 CCM.oddSourceWitnessK2) :=
      add_le_add (add_le_add (le_refl _) (mul_le_mul_of_nonneg_right he hXE)) (mul_le_mul_of_nonneg_right ho hXO)
    _ = _ := by unfold neutralRepairXBound; ring

/-- Both reflection components remain legal and neutral, even though only one
of their energy values is forced to be negative. -/
theorem neutral_parity_components {L : ℝ} (hL : 0 < L) (K : ℕ)
    (u : Fin (2 * K + 1) → ℂ) (hu : CCM.BoundaryFlatCoefficients K u)
    (hp : CCM.canonicalPoleExponentialMoment 1 L K u = 0)
    (hm : CCM.canonicalPoleExponentialMoment (-1) L K u = 0) :
    CCM.BoundaryFlatCoefficients K (CCM.evenPart K u) ∧
    CCM.BoundaryFlatCoefficients K (CCM.oddPart K u) ∧
    (CCM.canonicalPoleExponentialMoment 1 L K (CCM.evenPart K u) = 0 ∧
      CCM.canonicalPoleExponentialMoment (-1) L K (CCM.evenPart K u) = 0) ∧
    (CCM.canonicalPoleExponentialMoment 1 L K (CCM.oddPart K u) = 0 ∧
      CCM.canonicalPoleExponentialMoment (-1) L K (CCM.oddPart K u) = 0) := by
  have hflat : u ∈ CCM.boundaryFlatSubspace K := (CCM.mem_boundaryFlatSubspace_iff K u).mpr hu
  have heflat := (CCM.evenPart_mem_evenBoundaryFlatSubspace hflat).1
  have hoflat := (CCM.oddPart_mem_oddBoundaryFlatSubspace hflat).1
  have hz := (CCM.canonicalPoleExponentialMoments_iff_profiles hL K u).mp ⟨hp,hm⟩
  have hEo : CCM.poleEvenProfile L K ⬝ᵥ CCM.oddPart K u = 0 := by
    rw [dotProduct_comm]
    exact CCM.dotProduct_eq_zero_of_reverse_odd_even K _ _
      (CCM.reverseCoefficients_oddPart K u) (CCM.reverseCoefficients_poleEvenProfile L K)
  let elegal : CCM.euclideanEvenBoundaryFlatSubspace K :=
    ⟨WithLp.toLp 2 (CCM.evenPart K u),(CCM.mem_euclideanEvenBoundaryFlatSubspace_iff K _).mpr
      (CCM.evenPart_mem_evenBoundaryFlatSubspace hflat)⟩
  have hOe : CCM.poleOddProfile L K ⬝ᵥ CCM.evenPart K u = 0 :=
    CCM.poleOddProfile_dot_evenBoundaryFlat_eq_zero L K elegal
  have hEe : CCM.poleEvenProfile L K ⬝ᵥ CCM.evenPart K u = 0 := by
    have hs := congrArg (fun v => CCM.poleEvenProfile L K ⬝ᵥ v) (CCM.evenPart_add_oddPart K u)
    rw [dotProduct_add,hEo,add_zero] at hs
    exact hs.trans hz.1
  have hOo : CCM.poleOddProfile L K ⬝ᵥ CCM.oddPart K u = 0 := by
    have hs := congrArg (fun v => CCM.poleOddProfile L K ⬝ᵥ v) (CCM.evenPart_add_oddPart K u)
    rw [dotProduct_add,hOe,zero_add] at hs
    exact hs.trans hz.2
  exact ⟨(CCM.mem_boundaryFlatSubspace_iff K _).mp heflat,
    (CCM.mem_boundaryFlatSubspace_iff K _).mp hoflat,
    (CCM.canonicalPoleExponentialMoments_iff_profiles hL K _).mpr ⟨hEe,hOe⟩,
    (CCM.canonicalPoleExponentialMoments_iff_profiles hL K _).mpr ⟨hEo,hOo⟩⟩

end Zeta23.OPICARound2
